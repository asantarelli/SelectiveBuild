  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Writes SelectiveBuild.addin to the output with {VERSION} replaced by the built assembly's
       version (Major.Minor.Build), so AssemblyInfo.cs is the only place the version is set. -->
  <Target Name="StampAddinVersion" AfterTargets="Build">
    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="_BuiltAssembly" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <_FullVersion>%(_BuiltAssembly.Version)</_FullVersion>
      <_AddinVersion>$([System.Version]::Parse($(_FullVersion)).ToString(3))</_AddinVersion>
      <_AddinText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\SelectiveBuild.addin').Replace('{VERSION}', '$(_AddinVersion)'))</_AddinText>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)SelectiveBuild.addin" Lines="$(_AddinText)" Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
